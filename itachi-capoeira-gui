#!/usr/bin/env sh
# itachi-capoeira-gui (Linux/macOS) — abre a interface gráfica local do Itachi Capoeira: .venv/bin/python -m itachi_capoeira.gui
SRC="$0"
while [ -h "$SRC" ]; do
  D="$(cd -P "$(dirname "$SRC")" && pwd)"
  SRC="$(readlink "$SRC")"
  case "$SRC" in /*) ;; *) SRC="$D/$SRC" ;; esac
done
DIR="$(cd -P "$(dirname "$SRC")" && pwd)"
PY="$DIR/.venv/bin/python"
if [ ! -x "$PY" ]; then
  echo "Ambiente não instalado. Rode primeiro:  bash \"$DIR/install.sh\"" >&2
  exit 1
fi
cd "$DIR" || exit 1
PYTHONPATH="$DIR${PYTHONPATH:+:$PYTHONPATH}" exec "$PY" -m itachi_capoeira.gui "$@"
